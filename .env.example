TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=
# Replace with the connection string for your PostgreSQL server (pgAdmin is a GUI client).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/evchargers
REDIS_URL=redis://localhost:6379/0
OVERPASS_URL=https://maps.mail.ru/osm/tools/overpass/api/interpreter
OVERPASS_FALLBACK_URL=https://overpass.private.coffee/api/interpreter
OVERPASS_BUDGET_SECONDS=4
OVERPASS_COOLDOWN_SECONDS=60
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_FALLBACK_ENABLED=true
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_CACHE_DIR=work/map-tiles
SEARCH_RADIUS_METERS=5000
CACHE_TTL_SECONDS=900

